# --- Telegram -----------------------------------------------------------
# From @BotFather after /newbot. Keep this private.
TELEGRAM_BOT_TOKEN=
# Your personal chat id. Leave empty: the first person to send /start gets paired
# and the id is saved to data/settings.json. Set it here to lock it permanently.
TELEGRAM_CHAT_ID=

# --- Apple Calendar (iCloud, via CalDAV) ---------------------------------
# Your Apple Account email and an APP-SPECIFIC password from
# https://account.apple.com -> Sign-In and Security -> App-Specific Passwords
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Optional: the calendar name to use (defaults to the first writable calendar)
ICLOUD_CALENDAR=

# --- Claude -------------------------------------------------------------
# API key from the Console organization linked to your Max plan
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- App ----------------------------------------------------------------
# Secret that protects the /settings page. Any long random string.
SETTINGS_KEY=
# IANA timezone for interpreting times you type and formatting reminders
TZ=America/New_York
# Defaults the dropdown starts at: reminders per event (1 or 3) and the lead time
DEFAULT_REMINDER_COUNT=3
DEFAULT_LEAD_MINUTES=120
# Public https URL of the deployment (Render sets RENDER_EXTERNAL_URL itself).
# Leave both empty to run with long polling (local development, no tunnel needed).
PUBLIC_URL=
# Force long polling even if a public URL is set
POLLING=0
# Where settings.json lives
DATA_DIR=./data
